# Локальное окружение. Скопировать в .env и при необходимости поправить порты.
# .env под гитигнором — бриф, запрет №9: секретов в репозитории нет.

POSTGRES_USER=kttf
POSTGRES_PASSWORD=kttf_local_dev
POSTGRES_DB=kttf
POSTGRES_PORT=5433
REDIS_PORT=6380

# Пароль обязан совпадать с POSTGRES_PASSWORD в kttf-infra/.env.
DATABASE_URL="postgresql://kttf:kttf_local_dev@localhost:5433/kttf?schema=public"
REDIS_URL="redis://localhost:6380"

NODE_ENV=development
PORT=3000

# Ключи подписи и хеширования. Здесь заглушки для локальной разработки:
# в .env их нужно заменить своими, файл под гитигнором — бриф, запрет №9.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=local_dev_only_change_me_0123456789abcdef
