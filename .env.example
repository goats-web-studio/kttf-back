# Локальное окружение. Скопировать в .env и при необходимости поправить порты.
# .env под гитигнором — бриф, запрет №9: секретов в репозитории нет.

POSTGRES_USER=kttf
POSTGRES_PASSWORD=kttf_local_dev
POSTGRES_DB=kttf
POSTGRES_PORT=5433
REDIS_PORT=6380

DATABASE_URL="postgresql://kttf:kttf_local_dev@localhost:5433/kttf?schema=public"
REDIS_URL="redis://localhost:6380"

NODE_ENV=development
PORT=3000
