# Переводы строк всегда LF — и в репозитории, и в рабочей копии.
# Без этого Windows выдаёт CRLF, Prettier с endOfLine: lf возвращает LF,
# и каждый файл бесконечно числится изменённым.
* text=auto eol=lf

# Лок-файл не показываем в диффах: он машинный и огромный.
pnpm-lock.yaml -diff linguist-generated
