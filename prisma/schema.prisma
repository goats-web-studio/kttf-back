// Схема данных KTTF.
//
// Источник истины по модели — kttf-shared/docs/03-tech-spec.md, раздел 4.
// Изменения, накопленные по ходу разработки, перечислены там же в 05-state.md,
// раздел 6, и здесь помечены комментариями с указанием причины.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Строка подключения живёт в prisma.config.ts: начиная с Prisma 7
// свойство url в схеме не поддерживается. Клиент подключается через
// адаптер драйвера, а не через строку из схемы.
datasource db {
  provider = "postgresql"
}

// ============ Пользователи ============

model User {
  id    String  @id @default(uuid())
  phone String  @unique // E.164, +7XXXXXXXXXX
  // Логин — второй способ войти (ADR-034). Необязателен: аккаунты, заведённые
  // до перехода на пароль, живут без него.
  login String? @unique
  // scrypt с солью на пользователя, средствами node:crypto. Пустой означает,
  // что войти этим аккаунтом пока нельзя.
  passwordHash  String?
  phoneVerified Boolean  @default(false)
  email         String?  @unique
  locale        Locale   @default(RU)
  // Числовой chat_id Telegram. Уведомления — V2 (ТЗ 10), но собирается такое
  // годами, а понадобится сразу, поэтому поле заводится заранее. По @имени
  // бот писать не может, отсюда число, а не ник.
  telegramId    String?
  createdAt     DateTime @default(now())

  player    Player?
  clubRoles ClubMember[]
  sessions  Session[]
}

enum Locale {
  KK
  RU
  EN
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  createdAt    DateTime @default(now())
  // ТЗ 2.1: сессия живёт 90 дней и продлевается при активности
  expiresAt    DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ============ Игроки ============

model Player {
  id     String  @id @default(uuid())
  userId String? @unique // null = заведён организатором, аккаунта нет
  user   User?   @relation(fields: [userId], references: [id])

  lastName   String
  firstName  String
  middleName String? // необязательно — бриф, запрет №6
  birthYear  Int
  // Полная дата рождения — необязательна (ADR-035). Источник истины для
  // допуска остаётся birthYear: возрастные категории считаются по году,
  // и сравнение с birthYearFrom/birthYearTo идёт с ним. Год и дата обязаны
  // говорить одно и то же — правило в общем коде, createPlayerSchema.
  birthDate  DateTime? @db.Date
  // Показывать посторонним только год — ADR-037. Хранится ровно так, как
  // звучит галочка в форме: поле с отрицанием рано или поздно прочитают
  // наоборот, и дата уедет наружу у того, кто её прятал. Умолчание true:
  // до появления даты профиль показывал только год, и включённая галочка
  // ничего не меняет в том, что о человеке видно.
  birthYearOnly Boolean @default(true)
  gender     Gender
  city       String
  photoUrl   String?
  clubId     String?
  club       Club?   @relation(fields: [clubId], references: [id])

  // Анкета ТЗ 2.2. Инвентарь строкой, а не справочником: свой справочник
  // моделей нужно наполнять и чистить, это отдельный продукт (ADR-035).
  playingHand    PlayingHand?
  grip           Grip?
  blade          String?
  rubberForehand String?
  rubberBackhand String?
  bio            String?

  // Тренер задаётся либо выбором из уже заведённых игроков, либо строкой,
  // но не обоими сразу. Роли тренера в продукте ещё нет: «тренер» — это тот,
  // на кого сослались, и список берётся из самих данных.
  coachPlayerId String?
  coach         Player?  @relation("PlayerCoach", fields: [coachPlayerId], references: [id])
  students      Player[] @relation("PlayerCoach")
  coachName     String?

  // Проекция рейтинга. Источник истины — RatingEvent, это материализованное
  // представление для быстрых выборок (ТС 1.4).
  rating        Decimal @default(250) @db.Decimal(8, 2)
  ratedMatches  Int     @default(0)
  isProvisional Boolean @default(true)
  trustScore    Decimal @default(100) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  registrations Registration[]
  ratingEvents  RatingEvent[]

  @@index([rating(sort: Desc)])
  @@index([city, rating(sort: Desc)])
  @@index([lastName, firstName])
  // Список тренеров — это выборка distinct по ссылке. Без индекса она
  // прочитала бы всю таблицу игроков ради выпадающего списка в форме.
  @@index([coachPlayerId])
}

enum Gender {
  MALE
  FEMALE
}

/// Игровая рука — ТЗ 2.2.
enum PlayingHand {
  RIGHT
  LEFT
}

/// Хват — ТЗ 2.2. Третьего в настольном теннисе нет: европейский
/// (горизонтальный) и азиатский, он же «перо».
enum Grip {
  SHAKEHAND
  PENHOLD
}

// ============ Клубы ============

model Club {
  id          String  @id @default(uuid())
  name        String
  shortName   String?
  city        String
  address     String?
  lat         Float?
  lng         Float?
  tableCount  Int     @default(1)
  phone       String?
  whatsapp    String?
  instagram   String?
  logoUrl     String?
  description String?

  balance  Decimal @default(0) @db.Decimal(12, 2)
  tariffId String?
  tariff   Tariff? @relation(fields: [tariffId], references: [id])

  createdAt DateTime @default(now())

  members      ClubMember[]
  tournaments  Tournament[]
  players      Player[]
  transactions Transaction[]

  @@index([city])
}

model ClubMember {
  id     String   @id @default(uuid())
  clubId String
  userId String
  role   ClubRole
  club   Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

enum ClubRole {
  OWNER
  ORGANIZER
  REFEREE
}

// ============ Турниры ============

model Tournament {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  name               String
  startsAt           DateTime
  registrationEndsAt DateTime?
  status             TournamentStatus @default(DRAFT)

  entryFee        Int      @default(0) // тенге
  maxParticipants Int?
  ratingCapMax    Decimal? @db.Decimal(8, 2)
  ratingCapMin    Decimal? @db.Decimal(8, 2)
  birthYearFrom   Int?
  birthYearTo     Int?
  genderLimit     Gender?

  level      TournamentLevel @default(CLUB) // коэффициент T в формуле рейтинга
  tableCount Int

  formatConfig  Json // конфигурация схемы, ТС 4.2
  seedingConfig Json? // посев и разведение по клубам, ТС 4.2 и ADR-011

  description String?
  prizeInfo   String?

  publicToken String @unique // второй экран, ТЗ 6.5

  // Офлайн-синхронизация, ТС 6.3: растёт на каждое изменение турнира.
  // Консоль присылает версию снимка, против которого работала.
  version Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  ratedAt    DateTime?

  registrations  Registration[]
  stages         Stage[]
  matches        Match[]
  ratingEvents   RatingEvent[]
  transactions   Transaction[]
  syncOperations SyncOperation[]

  @@index([status, startsAt])
  @@index([clubId, startsAt(sort: Desc)])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REG_OPEN
  REG_CLOSED
  RUNNING
  FINISHED
  RATED
  CANCELLED
}

enum TournamentLevel {
  CLUB
  REGIONAL
  NATIONAL
}

model Registration {
  id           String             @id @default(uuid())
  tournamentId String
  playerId     String
  status       RegistrationStatus @default(REGISTERED)
  seed         Int?
  isRated      Boolean            @default(true) // false = вне зачёта
  paidAt       DateTime?
  paymentId    String?

  // ДОБАВЛЕНО сверх первой редакции ТС. Причина — ТС 5.4: рейтинги
  // фиксируются на момент старта турнира. Без снимка расчёт зависит от
  // порядка обработки встреч, и локальный расчёт консоли расходится
  // с серверным. Заполняются при переходе турнира в RUNNING.
  ratingAtStart  Decimal? @db.Decimal(8, 2)
  matchesAtStart Int?

  createdAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([tournamentId, status])
  @@index([playerId])
}

enum RegistrationStatus {
  REGISTERED
  WAITLIST
  CONFIRMED
  PLAYING
  WITHDRAWN
  NO_SHOW
}

// ============ Этапы и встречи ============

model Stage {
  id           String    @id @default(uuid())
  tournamentId String
  order        Int
  type         StageType
  name         String
  config       Json

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups     Group[]
  matches    Match[]

  @@unique([tournamentId, order])
}

enum StageType {
  GROUPS
  KNOCKOUT
  ROUND_ROBIN
  CONSOLATION
}

model Group {
  id      String @id @default(uuid())
  stageId String
  label   String // «гр. 1»
  order   Int
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  matches      Match[]
  tieDecisions TieDecision[]

  @@unique([stageId, order])
}

// Решение судьи по равенству в таблице (ADR-008).
//
// Движок не бросает жребий: он возвращает предложенный порядок и признак,
// что равенство не разрешено. Решение судьи хранится здесь и приходит
// в расчёт параметром, поэтому функция остаётся чистой и детерминированной,
// а консоль в офлайне и сервер получают одинаковые места.
model TieDecision {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Участники в порядке, который выбрал судья: массив Player.id.
  //
  // Именно Player.id, а не Registration.id: встреча ссылается на игроков,
  // и таблица считается по тем же ключам. Два разных ключа для одного
  // участника разошлись бы при первом же сравнении.
  orderedIds Json

  decidedBy String
  decidedAt DateTime @default(now())
  note      String?

  @@index([groupId])
}

model Match {
  id           String  @id @default(uuid())
  tournamentId String
  stageId      String
  groupId      String?

  // Участник может быть ещё не определён: в олимпийской сетке полуфинал —
  // это «победитель такой-то встречи». Пока он не сыгран, игрока здесь нет,
  // а откуда он возьмётся, сказано в sourceA/sourceB. Без этого сетку нельзя
  // развернуть целиком при жеребьёвке, а ТЗ 9.4 требует показывать её
  // в результатах, и второй экран показывает её по ходу турнира. См. ADR-019.
  playerAId String?
  playerBId String?

  // { "kind": "WINNER" | "LOSER", "matchId": "<Match.id>" } либо null,
  // если участник известен сразу.
  sourceA Json?
  sourceB Json?

  status      MatchStatus @default(PENDING)
  tableNumber Int?

  setsA      Int?
  setsB      Int?
  setScores  Json? // [[11,9],[9,11],[11,7]]
  resultType ResultType?

  bracketRound Int?
  bracketSlot  Int?

  startedAt  DateTime?
  finishedAt DateTime?

  // Офлайн-синхронизация, ТС 6
  clientId      String? @unique // UUID, сгенерированный клиентом
  clientVersion Int     @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group      Group?     @relation(fields: [groupId], references: [id])

  ratingEvents RatingEvent[]

  @@index([tournamentId, status])
  @@index([stageId, groupId])
}

enum MatchStatus {
  PENDING
  QUEUED
  PLAYING
  FINISHED
  CANCELLED
}

enum ResultType {
  NORMAL
  WALKOVER
  RETIRED
}

// ============ Рейтинг ============

// Журнал рейтинговых событий — источник истины (ТС 1.4, бриф запрет №3).
// Player.rating это проекция, которую можно пересобрать отсюда целиком.
model RatingEvent {
  id           String  @id @default(uuid())
  playerId     String
  matchId      String?
  tournamentId String?

  type         RatingEventType
  ratingBefore Decimal         @db.Decimal(8, 2)
  delta        Decimal         @db.Decimal(8, 2)
  ratingAfter  Decimal         @db.Decimal(8, 2)

  // Параметры расчёта — для аудита и пересчёта.
  opponentRating Decimal? @db.Decimal(8, 2)
  kFactor        Decimal? @db.Decimal(5, 2)
  tFactor        Decimal? @db.Decimal(5, 2)
  mFactor        Decimal? @db.Decimal(5, 2)
  expected       Decimal? @db.Decimal(6, 4)

  // ДОБАВЛЕНО сверх первой редакции ТС. Формула 2.0, ADR-003.
  //
  // gapMultiplier — множитель разрыва G: при превосходстве победителя
  // на 100 и более рейтинг не меняется ни у кого.
  //
  // imbalance — расхождение дельт. Ненулевое только когда победитель
  // провизорный. Это единственный канал, по которому рейтинг попадает
  // в систему извне, и он обязан быть измеримым (ТС 5.6).
  //
  // clamped — сработала отсечка по MIN_RATING, фактическая дельта
  // отличается от расчётной. Единственное место, где замкнутость
  // нарушается механически, поэтому фиксируется явно.
  gapMultiplier Decimal? @db.Decimal(5, 4)
  imbalance     Decimal? @db.Decimal(8, 2)
  clamped       Boolean  @default(false)

  reason    String? // для ручных корректировок
  createdBy String?
  createdAt DateTime @default(now())

  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match      Match?      @relation(fields: [matchId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([playerId, createdAt(sort: Desc)])
  @@index([tournamentId])
  @@index([matchId])
}

enum RatingEventType {
  MATCH
  INITIAL
  MANUAL_ADJUST
  RECALC
}

// ============ Финансы ============

model Transaction {
  id           String          @id @default(uuid())
  clubId       String
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  tournamentId String?
  description  String
  createdAt    DateTime        @default(now())

  club       Club        @relation(fields: [clubId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([clubId, createdAt(sort: Desc)])
}

enum TransactionType {
  TOPUP
  TOURNAMENT_FEE
  REFUND
  ADJUSTMENT
  PAYOUT
}

model Tariff {
  id               String  @id @default(uuid())
  name             String
  perParticipant   Int // тенге за участника
  perTournamentCap Int? // потолок за турнир
  monthlyFee       Int? // подписка
  isDefault        Boolean @default(false)

  clubs Club[]
}

// ============ Аномалии рейтинга ============

model RatingAnomaly {
  id         String        @id @default(uuid())
  playerId   String
  matchId    String?
  type       AnomalyType
  severity   Int // 1-10
  details    Json
  status     AnomalyStatus @default(OPEN)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime      @default(now())

  @@index([status, severity(sort: Desc)])
  @@index([playerId])
}

enum AnomalyType {
  LOSS_STREAK_BEFORE_CAPPED
  UPSET_LOSS
  PATTERN_DROP_WIN_RETURN
  UNUSUAL_SCORE
}

enum AnomalyStatus {
  OPEN
  REVIEWING
  CONFIRMED
  DISMISSED
}

// ============ Синхронизация офлайн-консоли ============

// ТС 6.3 и ADR-026. Журнал операций, пришедших из очереди консоли.
//
// Запись появляется ДО применения операции: обрыв между применением
// и отметкой оставил бы её неотмеченной, и повторная отправка применила бы
// счёт дважды. Уникальный (tournamentId, clientOpId) — это и есть
// идемпотентность синхронизации.
model SyncOperation {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  clientOpId String // UUID, выданный клиентом
  seq        Int // порядок в очереди клиента
  type       String // тип операции, ТС 6.2
  payload    Json?

  // Версия снимка, против которого судья вводил операцию. Ничего не
  // блокирует: конфликт решает порядок (ADR-026). Нужна для разбора спора.
  basedOnVersion Int

  actorId        String
  receivedAt     DateTime  @default(now())
  appliedAt      DateTime?
  // Код отказа из общего перечня. Заполнен — операция отклонена.
  rejectedReason String?

  @@unique([tournamentId, clientOpId])
  @@index([tournamentId, seq])
}

// ============ Журнал действий ============

// ТЗ 12 и ТС 8.3: все изменения рейтинга, финансовые операции
// и изменения результатов протоколируются.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}
