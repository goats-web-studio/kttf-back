// Схема данных KTTF.
//
// Источник истины по модели — kttf-shared/docs/03-tech-spec.md, раздел 4.
// Изменения, накопленные по ходу разработки, перечислены там же в 05-state.md,
// раздел 6, и здесь помечены комментариями с указанием причины.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Строка подключения живёт в prisma.config.ts: начиная с Prisma 7
// свойство url в схеме не поддерживается. Клиент подключается через
// адаптер драйвера, а не через строку из схемы.
datasource db {
  provider = "postgresql"
}

// ============ Пользователи ============

model User {
  id            String    @id @default(uuid())
  phone         String    @unique // E.164, +7XXXXXXXXXX
  // Логин — второй способ войти (ADR-034). Необязателен: аккаунты, заведённые
  // до перехода на пароль, живут без него.
  login         String?   @unique
  // scrypt с солью на пользователя, средствами node:crypto. Пустой означает,
  // что войти этим аккаунтом пока нельзя.
  passwordHash  String?
  phoneVerified Boolean   @default(false)
  email         String?   @unique
  locale        Locale    @default(RU)
  // Числовой chat_id Telegram. Уведомления — V2 (ТЗ 10), но собирается такое
  // годами, а понадобится сразу, поэтому поле заводится заранее. По @имени
  // бот писать не может, отсюда число, а не ник.
  telegramId    String?
  // Администратор платформы — ТЗ 1, ADR-046. Ведёт справочники. Выдаётся
  // скриптом scripts/set-admin.mjs: маршрута, который делает человека
  // администратором, наружу нет.
  isAdmin       Boolean   @default(false)
  // Последнее посещение — ADR-050. Пишется на запросах с токеном не чаще
  // раза в пять минут: точнее «в сети» не нужно, а запись на каждый запрос
  // превратила бы чтение сайта в поток UPDATE.
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())

  player           Player?
  clubRoles        ClubMember[]
  clubPosts        ClubPost[]
  clubMedia        ClubMedia[]
  coachPosts       CoachPost[]
  coachMedia       CoachMedia[]
  sessions         Session[]
  clubApplications ClubApplication[]
  products         Product[]
  coaches          Coach[]
  trialRequests    TrialRequest[]    @relation("TrialRequester")
  trialAnswers     TrialRequest[]    @relation("TrialAnswerer")
  notifications    Notification[]
}

enum Locale {
  KK
  RU
  EN
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  createdAt    DateTime @default(now())
  // ТЗ 2.1: сессия живёт 90 дней и продлевается при активности
  expiresAt    DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ============ Игроки ============

model Player {
  id     String  @id @default(uuid())
  userId String? @unique // null = заведён организатором, аккаунта нет
  user   User?   @relation(fields: [userId], references: [id])

  lastName      String
  firstName     String
  middleName    String? // необязательно — бриф, запрет №6
  birthYear     Int
  // Полная дата рождения — необязательна (ADR-035). Источник истины для
  // допуска остаётся birthYear: возрастные категории считаются по году,
  // и сравнение с birthYearFrom/birthYearTo идёт с ним. Год и дата обязаны
  // говорить одно и то же — правило в общем коде, createPlayerSchema.
  birthDate     DateTime? @db.Date
  // Показывать посторонним только год — ADR-037. Хранится ровно так, как
  // звучит галочка в форме: поле с отрицанием рано или поздно прочитают
  // наоборот, и дата уедет наружу у того, кто её прятал. Умолчание true:
  // до появления даты профиль показывал только год, и включённая галочка
  // ничего не меняет в том, что о человеке видно.
  birthYearOnly Boolean   @default(true)
  gender        Gender
  // Город из справочника — ADR-046. Была свободная строка, и «Алматы»
  // с «алматы » расходились по фильтрам как два разных города.
  cityId        String
  city          City      @relation(fields: [cityId], references: [id])
  photoUrl      String?
  clubId        String?
  club          Club?     @relation(fields: [clubId], references: [id])

  // Анкета ТЗ 2.2. Инвентарь строкой, а не справочником: свой справочник
  // моделей нужно наполнять и чистить, это отдельный продукт (ADR-035).
  playingHand    PlayingHand?
  grip           Grip?
  blade          String?
  rubberForehand String?
  rubberBackhand String?
  bio            String?

  // Инвентарь из каталога маркета — ADR-058, docs/10 4.2. Строки выше
  // остаются для того, чего в каталоге нет. Основание — товар BLADE,
  // накладки — RUBBER: категорию сверяет сервер. Товар удалён — ссылка
  // стирается, строка остаётся.
  bladeProductId          String?
  bladeProduct            Product? @relation("PlayerBlade", fields: [bladeProductId], references: [id], onDelete: SetNull)
  rubberForehandProductId String?
  rubberForehandProduct   Product? @relation("PlayerRubberForehand", fields: [rubberForehandProductId], references: [id], onDelete: SetNull)
  rubberBackhandProductId String?
  rubberBackhandProduct   Product? @relation("PlayerRubberBackhand", fields: [rubberBackhandProductId], references: [id], onDelete: SetNull)

  // Тренер задаётся либо выбором из уже заведённых игроков, либо строкой,
  // но не обоими сразу. Роли тренера в продукте ещё нет: «тренер» — это тот,
  // на кого сослались, и список берётся из самих данных.
  coachPlayerId String?
  coach         Player?  @relation("PlayerCoach", fields: [coachPlayerId], references: [id])
  students      Player[] @relation("PlayerCoach")
  coachName     String?

  // Проекция рейтинга. Источник истины — RatingEvent, это материализованное
  // представление для быстрых выборок (ТС 1.4).
  rating        Decimal @default(250) @db.Decimal(8, 2)
  ratedMatches  Int     @default(0)
  isProvisional Boolean @default(true)
  trustScore    Decimal @default(100) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  registrations  Registration[]
  // Записи на турниры, где игрок указан тренером участника (T3).
  coachedEntries Registration[] @relation("RegistrationCoach")
  ratingEvents   RatingEvent[]
  // Страница тренера на этом профиле — ADR-059. Не путать с `coach`:
  // там тренер, которого игрок выбрал себе в анкете.
  coachPage      Coach?
  // История тренеров — T2 (ADR-059): свои периоды и периоды учеников
  coachTenures   CoachTenure[]  @relation("TenurePlayer")
  studentTenures CoachTenure[]  @relation("TenureCoach")

  @@index([rating(sort: Desc)])
  @@index([cityId, rating(sort: Desc)])
  @@index([lastName, firstName])
  // Список тренеров — это выборка distinct по ссылке. Без индекса она
  // прочитала бы всю таблицу игроков ради выпадающего списка в форме.
  @@index([coachPlayerId])
  // «Кто играет» — список игроков с фильтром по товару (ADR-058).
  @@index([bladeProductId])
  @@index([rubberForehandProductId])
  @@index([rubberBackhandProductId])
}

enum Gender {
  MALE
  FEMALE
}

/// Игровая рука — ТЗ 2.2.
enum PlayingHand {
  RIGHT
  LEFT
}

/// Хват — ТЗ 2.2. Третьего в настольном теннисе нет: европейский
/// (горизонтальный) и азиатский, он же «перо».
enum Grip {
  SHAKEHAND
  PENHOLD
}

// ============ Справочник стран и городов ============

// ADR-046. Ведёт администратор платформы. Записи не удаляются, а скрываются:
// на город ссылаются клубы и игроки, и удаление оставило бы их без города.
// Скрытый город не предлагается в формах, но остаётся у тех, у кого указан.
//
// Название по-русски обязательно, по-казахски — по желанию: казахский
// интерфейс без него показывает русское.

model Country {
  id        String  @id @default(uuid())
  code      String  @unique // ISO 3166-1 alpha-2
  name      String
  nameKk    String?
  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  cities City[]
}

model City {
  id        String  @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  name      String
  nameKk    String?
  // Столицы впереди, остальное по алфавиту: порядок задаёт администратор.
  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  clubs   Club[]
  players Player[]
  coaches Coach[]

  @@unique([countryId, name])
}

// ============ Клубы ============

model Club {
  id          String  @id @default(uuid())
  name        String
  shortName   String?
  cityId      String // справочник, ADR-046
  city        City    @relation(fields: [cityId], references: [id])
  address     String?
  lat         Float?
  lng         Float?
  tableCount  Int     @default(1)
  phone       String?
  whatsapp    String?
  instagram   String?
  logoUrl     String?
  description String?

  // Страница клуба — ADR-055, docs/09
  coverUrl          String?
  website           String?
  telegram          String?
  twoGisUrl         String?
  amenities         ClubAmenity[] @default([])
  tableBrand        String?
  floorType         FloorType?
  ceilingHeightCm   Int?
  hoursNote         String?
  primaryContact    ContactKind?
  profileReviewedAt DateTime?
  // Тариф страницы заложен и выключен (ADR-055); это не Tariff — плата за турниры
  plan              ClubPlan      @default(FREE)
  planUntil         DateTime?
  // Скрыт из каталога администратором
  hiddenAt          DateTime?

  balance  Decimal @default(0) @db.Decimal(12, 2)
  tariffId String?
  tariff   Tariff? @relation(fields: [tariffId], references: [id])

  createdAt DateTime @default(now())

  members      ClubMember[]
  tournaments  Tournament[]
  players      Player[]
  transactions Transaction[]
  hours        ClubHours[]
  prices       ClubPrice[]
  stats        ClubStatDaily[]
  posts        ClubPost[]
  media        ClubMedia[]
  tables       ClubTable[]
  trainings    Training[]
  coachLinks   ClubCoach[]
  trials       TrialRequest[]

  @@index([cityId])
}

enum ClubAmenity {
  AIR_CONDITIONING
  SHOWER
  PARKING
  LOCKER_ROOM
  WIFI
  CAFE
  SHOP
  KIDS
}

enum FloorType {
  SPORT_COVER
  LINOLEUM
  WOOD
  OTHER
}

enum ContactKind {
  PHONE
  WHATSAPP
  TELEGRAM
}

enum ClubPlan {
  FREE
  PRO
}

// Часы работы: минуты от полуночи по UTC+5; closesMin > 1440 — после полуночи
model ClubHours {
  clubId    String
  weekday   Int // 1 — понедельник … 7 — воскресенье
  opensMin  Int
  closesMin Int
  club      Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, weekday, opensMin])
}

model ClubPrice {
  id        String    @id @default(uuid())
  clubId    String
  kind      PriceKind
  title     String
  priceKzt  Int
  unit      PriceUnit
  note      String?
  sortOrder Int
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, sortOrder])
}

// TRAINING и KIDS — прежние строки: тренировки теперь отдельной сущностью
// (ADR-059), новые строки прайса этих видов не принимаются и не отдаются.
enum PriceKind {
  TABLE_RENT
  HALL_RENT
  MEMBERSHIP
  TRAINING
  KIDS
  OTHER
}

enum PriceUnit {
  HOUR
  VISIT
  MONTH
  COURSE
  NONE
}

// Дневные счётчики страницы клуба — без IP и cookie (ADR-055)
model ClubStatDaily {
  clubId              String
  date                DateTime      @db.Date // день по UTC+5
  source              TrafficSource
  views               Int           @default(0)
  phoneClicks         Int           @default(0)
  whatsappClicks      Int           @default(0)
  telegramClicks      Int           @default(0)
  instagramClicks     Int           @default(0)
  websiteClicks       Int           @default(0)
  routeClicks         Int           @default(0)
  // «Записаться» к тренеру на его личную тренировку в зале клуба (ADR-059)
  coachTrainingClicks Int           @default(0)
  // Заявки на пробную с сайта (ADR-059, T3)
  trialRequests       Int           @default(0)
  club                Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, date, source])
}

enum TrafficSource {
  ORGANIC
  CAMPAIGN
}

// Новости и акции клуба — ADR-055, docs/09 3.2. Публикуются сразу, администратор скрывает
model ClubPost {
  id           String    @id @default(uuid())
  clubId       String
  kind         PostKind
  title        String
  body         String // простой текст, без HTML
  imageUrl     String?
  validUntil   DateTime? @db.Date // последний день акции
  pinnedAt     DateTime?
  publishedAt  DateTime  @default(now())
  editedAt     DateTime?
  authorId     String?
  hiddenAt     DateTime?
  hiddenReason String?
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clubId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
}

enum PostKind {
  NEWS
  PROMO
}

// Фото и видео клуба. У видео imageUrl — его обложка, скачанная к нам
model ClubMedia {
  id           String    @id @default(uuid())
  clubId       String
  kind         MediaKind
  imageUrl     String
  youtubeId    String?
  width        Int
  height       Int
  caption      String?
  sortOrder    Int
  createdById  String?
  createdAt    DateTime  @default(now())
  hiddenAt     DateTime?
  hiddenReason String?
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clubId, sortOrder])
  @@index([createdAt(sort: Desc)])
}

enum MediaKind {
  PHOTO
  VIDEO
}

model ClubMember {
  id     String   @id @default(uuid())
  clubId String
  userId String
  role   ClubRole
  club   Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

enum ClubRole {
  OWNER
  ORGANIZER
  REFEREE
}

// ============ Заявки клубов ============

// ADR-047. Зал, который хочет проводить турниры в KTTF, оставляет заявку на
// сайте; администратор платформы видит её в кабинете и связывается сам.
// Отправить может и аноним: представитель зала ещё не пользователь.
model ClubApplication {
  id          String                @id @default(uuid())
  name        String
  // Телефон или email как написал человек: формат не навязывается.
  contact     String
  clubName    String
  // Строкой, не ссылкой на справочник: заявки приходят и из городов,
  // которых в справочнике ещё нет.
  city        String
  address     String?
  tableCount  Int?
  tournaments String?
  message     String?
  status      ClubApplicationStatus @default(NEW)
  // Заявку оставил вошедший пользователь. Удалён аккаунт — заявка остаётся.
  userId      String?
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  // HMAC адреса отправителя — для лимита заявок с одного адреса. Сам адрес
  // не хранится: для лимита достаточно сравнить, а адрес — персональные данные.
  ipHash      String
  createdAt   DateTime              @default(now())
  handledAt   DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
}

enum ClubApplicationStatus {
  NEW
  DONE
}

// ============ Каталог маркета ============

// ADR-058, docs/10 4.1. Общий справочник инвентаря: товары и производители.
// Ведёт администратор платформы, наполняется импортом выгрузки RTTF.
// Поиск — pg_trgm: индексы по lower(name) заведены в миграции SQL, схема
// Prisma выражений в индексах не описывает.
model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  country   String?
  website   String?
  logoUrl   String?
  // Производитель RTTF — ключ повторного импорта
  rttfId    Int?      @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id                    String          @id @default(uuid())
  category              ProductCategory
  brandId               String
  brand                 Brand           @relation(fields: [brandId], references: [id])
  // «E. Lebesson» — без слова категории и производителя
  name                  String
  slug                  String          @unique
  // Русские написания для поиска: «Лебессон»
  aliases               String[]        @default([])
  description           String? // простой текст
  // Характеристики и оси вариантов. Схема — по категории, PRODUCT_ATTRIBUTES
  // в kttf-shared: база её не знает, проверяет сервер
  attrs                 Json            @default("{}")
  options               Json            @default("{}")
  status                ProductStatus   @default(PUBLISHED)
  // Порядок «популярные»: просмотры, при импорте — начальное значение RTTF
  popularity            Int             @default(0)
  // Товар RTTF — ключ повторного импорта
  rttfId                Int?            @unique
  createdById           String?
  createdBy             User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  hiddenAt              DateTime?
  images                ProductImage[]
  // Инвентарь игроков и столы клубов — M1.2
  bladePlayers          Player[]        @relation("PlayerBlade")
  rubberForehandPlayers Player[]        @relation("PlayerRubberForehand")
  rubberBackhandPlayers Player[]        @relation("PlayerRubberBackhand")
  clubTables            ClubTable[]

  @@index([category, status, hiddenAt])
  @@index([brandId])
  @@index([attrs], type: Gin)
  @@index([options], type: Gin)
}

enum ProductCategory {
  BLADE
  RUBBER
  RACKET
  BALL
  CASE
  BAG
  TOP
  BOTTOM
  SOCKS
  SHOES
  TABLE
  OTHER
}

// PENDING — карточку предложил магазин (M1.3), в общем каталоге её нет
enum ProductStatus {
  PENDING
  PUBLISHED
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  width     Int
  height    Int
  sortOrder Int
  // Откуда фото: rttf.ru, магазин, производитель — чтобы найти и заменить чужое
  credit    String?
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// Модели столов клуба из каталога маркета — ADR-058, docs/10 4.2. Правятся
// списком целиком, как часы и цены. Сумма может не совпасть с tableCount:
// столы без известной модели в список не попадают.
model ClubTable {
  clubId    String
  productId String
  count     Int
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clubId, productId])
  // «Где стоит» — клубы со столом этой модели.
  @@index([productId])
}

// ============ Тренеры ============

// ADR-059, docs/11 4. Страница тренера строится на профиле игрока: имя, фото
// и рейтинг берутся оттуда. Заявка — статус самой страницы, а не отдельная
// таблица: администратор видит ровно то, что будет опубликовано. Публичны
// только APPROVED и не скрытые.
model Coach {
  id                String          @id @default(uuid())
  playerId          String          @unique
  player            Player          @relation(fields: [playerId], references: [id])
  // Кто правит страницу — аккаунт игрока на момент заведения.
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  slug              String          @unique
  status            CoachStatus     @default(DRAFT)
  rejectReason      String?
  reviewedAt        DateTime?
  // Последняя отправка на проверку — порядок очереди у администратора.
  submittedAt       DateTime?
  headline          String?
  about             String?
  coverUrl          String?
  photoUrl          String?
  coachingSince     Int?
  cityId            String?
  city              City?           @relation(fields: [cityId], references: [id])
  formats           TrainingPlace[] @default([])
  visitAreas        String?
  languages         CoachLanguage[] @default([])
  phone             String?
  whatsapp          String?
  telegram          String?
  instagram         String?
  primaryContact    ContactKind?
  sportsRank        SportsRank?
  coachCategory     CoachCategory?
  refereeCategory   String?
  education         String?
  profileReviewedAt DateTime?
  // Тариф заложен и выключен, как у клуба (ADR-055)
  plan              CoachPlan       @default(FREE)
  planUntil         DateTime?
  // Скрыта администратором (постмодерация); причину видит тренер
  hiddenAt          DateTime?
  hiddenReason      String?
  createdAt         DateTime        @default(now())

  trainings    Training[]
  credentials  CoachCredential[]
  achievements CoachAchievement[]
  stats        CoachStatDaily[]
  clubLinks    ClubCoach[]
  posts        CoachPost[]
  media        CoachMedia[]
  trials       TrialRequest[]

  // Публичный список: одобренные, не скрытые, свежие сверху.
  @@index([status, hiddenAt, profileReviewedAt])
  @@index([cityId])
  @@index([userId])
}

enum CoachStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TrainingPlace {
  CLUB
  VISIT
  ONLINE
}

enum CoachLanguage {
  KK
  RU
  EN
}

enum TrainingKind {
  INDIVIDUAL
  GROUP
  SPLIT
  KIDS_GROUP
  VIDEO_REVIEW
  CAMP
  SPARRING
  OTHER
}

enum TrainingAudience {
  KIDS
  TEENS
  ADULT_BEGINNERS
  AMATEURS
  ATHLETES
}

enum SportsRank {
  YOUTH_3
  YOUTH_2
  YOUTH_1
  RANK_3
  RANK_2
  RANK_1
  KMS
  MS
  MSMK
  ZMS
}

enum CoachCategory {
  HIGHEST
  FIRST
  SECOND
  NONE
}

enum CredentialKind {
  DIPLOMA
  CERTIFICATE
  COURSE
  LICENSE
  OTHER
}

enum AchievementRole {
  AS_PLAYER
  AS_COACH
}

enum CoachPlan {
  FREE
  PRO
}

// Тренировка — решение владельца от 20.10.2026: её заводит тренер на своей
// странице или клуб на своей. «В клубе» у тренера — клуб KTTF (clubId,
// клуб подтверждает) или зал вне KTTF названием и адресом. Клуб указывает
// тренера со страницей — подтверждает тренер. link — связь со второй
// стороной; разорвать её может любая сторона.
model Training {
  id           String              @id @default(uuid())
  author       TrainingAuthor
  coachId      String?
  coach        Coach?              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clubId       String?
  club         Club?               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  link         TrainingLink        @default(NONE)
  // Кто записывает и принимает оплату. У своей тренировки тренера в клубе
  // KTTF — тренер лично или клуб; у клубной и без клуба — как задано сервером
  booking      TrainingBooking     @default(COACH)
  // Когда вторая сторона подтвердила, отказала или разорвала связь
  linkAt       DateTime?
  kind         TrainingKind
  audiences    TrainingAudience[]
  kidsFromAge  Int?
  place        TrainingPlace
  // Зал вне KTTF — у тренировки тренера «в клубе» без clubId
  venueName    String?
  venueAddress String?
  title        String
  schedule     String?
  // Без цены — «по договорённости»
  priceKzt     Int?
  unit         PriceUnit
  note         String?
  // «Подробнее» — простой текст
  description  String?
  // Набор в группу — T3 (ADR-059): есть места, мало мест, закрыт; null — не указан
  enrollment   TrainingEnrollment?
  // Занятия по дням недели — T3; строка schedule остаётся примечанием
  slots        TrainingSlot[]
  trials       TrialRequest[]
  sortOrder    Int
  createdAt    DateTime            @default(now())

  @@index([coachId, sortOrder])
  @@index([clubId, sortOrder])
  // Раздел «Тренировки»: выезд и онлайн, входящие запросы по статусу связи
  @@index([place, link])
}

enum TrainingAuthor {
  COACH
  CLUB
}

// Занятие тренировки — день недели и время по UTC+5, как часы клуба (ADR-055).
// Правится вместе со строкой тренировки целиком.
model TrainingSlot {
  id         String   @id @default(uuid())
  trainingId String
  weekday    Int // 1 — понедельник … 7 — воскресенье
  startMin   Int
  endMin     Int
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  // Фильтры раздела «Тренировки»: день недели и время суток
  @@index([weekday, startMin])
}

enum TrainingEnrollment {
  OPEN
  FEW
  CLOSED
}

enum TrainingBooking {
  COACH
  CLUB
}

enum TrainingLink {
  NONE
  PENDING
  CONFIRMED
  DECLINED
}

// Новости и акции тренера — T2.2 (ADR-059, docs/11 3.2.2): механика ClubPost
// один в один. Публикуются сразу, администратор скрывает с причиной
model CoachPost {
  id           String    @id @default(uuid())
  coachId      String
  kind         PostKind
  title        String
  body         String // простой текст, без HTML
  imageUrl     String?
  validUntil   DateTime? @db.Date // последний день акции
  pinnedAt     DateTime?
  publishedAt  DateTime  @default(now())
  editedAt     DateTime?
  authorId     String?
  hiddenAt     DateTime?
  hiddenReason String?
  coach        Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([coachId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
}

// Фото и видео тренера — как ClubMedia. У видео imageUrl — его обложка у нас
model CoachMedia {
  id           String    @id @default(uuid())
  coachId      String
  kind         MediaKind
  imageUrl     String
  youtubeId    String?
  width        Int
  height       Int
  caption      String?
  sortOrder    Int
  createdById  String?
  createdAt    DateTime  @default(now())
  hiddenAt     DateTime?
  hiddenReason String?
  coach        Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([coachId, sortOrder])
  @@index([createdAt(sort: Desc)])
}

// Тренерский штаб клуба — T2 (ADR-059, решение владельца от 21.10.2026).
// Заводит любая сторона, вторая подтверждает; разорвать может любая.
// Подтверждённая тренировка в клубе добавляет тренера в штаб сама.
model ClubCoach {
  clubId      String
  coachId     String
  status      ClubCoachStatus
  // Должность строкой: «старший тренер», «детский тренер»
  position    String?
  requestedAt DateTime        @default(now())
  confirmedAt DateTime?
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coach       Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([clubId, coachId])
  @@index([coachId])
}

enum ClubCoachStatus {
  REQUESTED_BY_COACH
  INVITED_BY_CLUB
  ACTIVE
}

// История учеников — T2 (ADR-059). По игроку-тренеру, а не по странице:
// тренер выбирается в анкете и без страницы (ADR-035). Каждая смена
// Player.coachPlayerId закрывает открытый период и открывает новый.
model CoachTenure {
  playerId      String
  coachPlayerId String
  from          DateTime
  // null — тренер сейчас
  to            DateTime?
  player        Player    @relation("TenurePlayer", fields: [playerId], references: [id], onDelete: Cascade)
  coachPlayer   Player    @relation("TenureCoach", fields: [coachPlayerId], references: [id], onDelete: Cascade)

  @@id([playerId, coachPlayerId, from])
  @@index([coachPlayerId])
  @@index([playerId])
}

// Документ тренера. fileKey — путь загрузки скана (/api/v1/files/coach-docs/…);
// общей выдачей файлов эта папка не отдаётся — только маршрутом документа.
model CoachCredential {
  id         String         @id @default(uuid())
  coachId    String
  kind       CredentialKind
  title      String
  issuer     String?
  year       Int?
  fileKey    String?
  filePublic Boolean        @default(false)
  // «Проверено KTTF» — ставит администратор, снимается при правке документа
  verifiedAt DateTime?
  sortOrder  Int
  coach      Coach          @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, sortOrder])
}

model CoachAchievement {
  id        String          @id @default(uuid())
  coachId   String
  role      AchievementRole
  year      Int?
  title     String
  sortOrder Int
  coach     Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, sortOrder])
}

// Дневные счётчики страницы тренера — без IP и cookie, как у клуба (ADR-055)
model CoachStatDaily {
  coachId         String
  date            DateTime      @db.Date // день по UTC+5
  source          TrafficSource
  views           Int           @default(0)
  phoneClicks     Int           @default(0)
  whatsappClicks  Int           @default(0)
  telegramClicks  Int           @default(0)
  instagramClicks Int           @default(0)
  // «Записаться» в группу клуба, где он тренер
  clubGroupClicks Int           @default(0)
  // Заявки на пробную с сайта (T3)
  trialRequests   Int           @default(0)
  coach           Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([coachId, date, source])
}

// ============ Заявки на пробную и уведомления ============

// Заявка на пробную тренировку с сайта — T3 (ADR-059, docs/11 3.3.3).
// Отправляет только вошедший. Адресат — снимок того, кто записывает на
// тренировку в момент отправки (trainingBookingTarget): тренер или клуб.
model TrialRequest {
  id            String          @id @default(uuid())
  trainingId    String
  training      Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation("TrialRequester", fields: [userId], references: [id], onDelete: Cascade)
  targetKind    TrialTargetKind
  coachId       String?
  coach         Coach?          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clubId        String?
  club          Club?           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  forWhom       TrialFor
  childAge      Int?
  preferredTime String?
  comment       String?
  status        TrialStatus     @default(NEW)
  reply         String?
  source        TrafficSource
  createdAt     DateTime        @default(now())
  answeredAt    DateTime?
  // Кто ответил: тренер или OWNER/ORGANIZER клуба
  answeredById  String?
  answeredBy    User?           @relation("TrialAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([coachId, status, createdAt])
  @@index([clubId, status, createdAt])
  @@index([userId, createdAt])
  @@index([trainingId, userId, status])
}

enum TrialFor {
  SELF
  CHILD
}

enum TrialStatus {
  NEW
  ACCEPTED
  DECLINED
  CANCELLED
}

enum TrialTargetKind {
  COACH
  CLUB
}

// Уведомление внутри сайта — ТЗ 10, первая часть. data — снимок события,
// форма по типу (notificationViewSchema). Хранится NOTIFICATIONS_KEEP_DAYS.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  TRIAL_REQUEST_NEW
  TRIAL_REQUEST_CANCELLED
  TRIAL_REQUEST_ANSWERED
}

// ============ Турниры ============

model Tournament {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  name               String
  startsAt           DateTime
  registrationEndsAt DateTime?
  status             TournamentStatus @default(DRAFT)

  entryFee          Int      @default(0) // тенге
  maxParticipants   Int?
  ratingCapMax      Decimal? @db.Decimal(8, 2)
  ratingCapMin      Decimal? @db.Decimal(8, 2)
  // Заявки вне рейтинговой планки — на рассмотрение организатора, а не
  // отказ (ADR-044). Возраст и пол остаются жёсткими условиями.
  reviewOutOfRating Boolean  @default(false)
  birthYearFrom     Int?
  birthYearTo       Int?
  genderLimit       Gender?

  level      TournamentLevel @default(CLUB) // коэффициент T в формуле рейтинга
  tableCount Int

  formatConfig  Json // конфигурация схемы, ТС 4.2
  seedingConfig Json? // посев и разведение по клубам, ТС 4.2 и ADR-011

  description String?
  prizeInfo   String?

  publicToken String @unique // второй экран, ТЗ 6.5

  // Офлайн-синхронизация, ТС 6.3: растёт на каждое изменение турнира.
  // Консоль присылает версию снимка, против которого работала.
  version Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  ratedAt    DateTime?
  // Места записаны в заявки (ADR-048). Пусто у завершённого турнира — он
  // завершён до ADR-048, места досчитываются при первом обращении.
  placesAt   DateTime?

  registrations  Registration[]
  stages         Stage[]
  matches        Match[]
  ratingEvents   RatingEvent[]
  transactions   Transaction[]
  syncOperations SyncOperation[]

  @@index([status, startsAt])
  @@index([clubId, startsAt(sort: Desc)])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REG_OPEN
  REG_CLOSED
  RUNNING
  FINISHED
  RATED
  CANCELLED
}

enum TournamentLevel {
  CLUB
  REGIONAL
  NATIONAL
}

model Registration {
  id           String             @id @default(uuid())
  tournamentId String
  playerId     String
  status       RegistrationStatus @default(REGISTERED)
  seed         Int?
  isRated      Boolean            @default(true) // false = вне зачёта
  paidAt       DateTime?
  paymentId    String?

  // ДОБАВЛЕНО сверх первой редакции ТС. Причина — ТС 5.4: рейтинги
  // фиксируются на момент старта турнира. Без снимка расчёт зависит от
  // порядка обработки встреч, и локальный расчёт консоли расходится
  // с серверным. Заполняются при переходе турнира в RUNNING.
  ratingAtStart  Decimal? @db.Decimal(8, 2)
  matchesAtStart Int?

  // Итоговое место — ADR-048. Записывается при завершении турнира, чтобы
  // профиль игрока не пересчитывал весь турнир ради одного числа. Делённое
  // место — диапазоном place–placeTo («5–8»); точное — placeTo пуст.
  place   Int?
  placeTo Int?

  // Тренер участника на этом турнире — T3 (ADR-059). Снимок анкеты при
  // записи; до старта идёт за анкетой, пока его не поправили руками
  // (coachManual), после старта не меняется: по нему считаются медали
  // учеников. Как в анкете — игрок из списка либо строка, не оба.
  coachPlayerId String?
  coachPlayer   Player? @relation("RegistrationCoach", fields: [coachPlayerId], references: [id], onDelete: SetNull)
  coachName     String?
  coachManual   Boolean @default(false)

  createdAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([tournamentId, status])
  @@index([playerId])
  // Медали и турниры учеников на странице тренера (T3).
  @@index([coachPlayerId])
}

enum RegistrationStatus {
  REGISTERED
  // Заявка вне рейтинговой планки ждёт решения организатора, отказ по ней —
  // REJECTED (ADR-044). Ни та, ни другая места в турнире не занимает.
  PENDING
  WAITLIST
  CONFIRMED
  PLAYING
  WITHDRAWN
  NO_SHOW
  REJECTED
}

// ============ Этапы и встречи ============

model Stage {
  id           String    @id @default(uuid())
  tournamentId String
  order        Int
  type         StageType
  name         String
  config       Json

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups     Group[]
  matches    Match[]

  @@unique([tournamentId, order])
}

enum StageType {
  GROUPS
  KNOCKOUT
  ROUND_ROBIN
  CONSOLATION
}

model Group {
  id      String @id @default(uuid())
  stageId String
  label   String // «гр. 1»
  order   Int
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  matches      Match[]
  tieDecisions TieDecision[]

  @@unique([stageId, order])
}

// Решение судьи по равенству в таблице (ADR-008).
//
// Движок не бросает жребий: он возвращает предложенный порядок и признак,
// что равенство не разрешено. Решение судьи хранится здесь и приходит
// в расчёт параметром, поэтому функция остаётся чистой и детерминированной,
// а консоль в офлайне и сервер получают одинаковые места.
model TieDecision {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Участники в порядке, который выбрал судья: массив Player.id.
  //
  // Именно Player.id, а не Registration.id: встреча ссылается на игроков,
  // и таблица считается по тем же ключам. Два разных ключа для одного
  // участника разошлись бы при первом же сравнении.
  orderedIds Json

  decidedBy String
  decidedAt DateTime @default(now())
  note      String?

  @@index([groupId])
}

model Match {
  id           String  @id @default(uuid())
  tournamentId String
  stageId      String
  groupId      String?

  // Участник может быть ещё не определён: в олимпийской сетке полуфинал —
  // это «победитель такой-то встречи». Пока он не сыгран, игрока здесь нет,
  // а откуда он возьмётся, сказано в sourceA/sourceB. Без этого сетку нельзя
  // развернуть целиком при жеребьёвке, а ТЗ 9.4 требует показывать её
  // в результатах, и второй экран показывает её по ходу турнира. См. ADR-019.
  playerAId String?
  playerBId String?

  // { "kind": "WINNER" | "LOSER", "matchId": "<Match.id>" } либо null,
  // если участник известен сразу.
  sourceA Json?
  sourceB Json?

  status      MatchStatus @default(PENDING)
  tableNumber Int?

  setsA      Int?
  setsB      Int?
  setScores  Json? // [[11,9],[9,11],[11,7]]
  resultType ResultType?

  bracketRound Int?
  bracketSlot  Int?

  startedAt  DateTime?
  finishedAt DateTime?

  // Офлайн-синхронизация, ТС 6
  clientId      String? @unique // UUID, сгенерированный клиентом
  clientVersion Int     @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group      Group?     @relation(fields: [groupId], references: [id])

  ratingEvents RatingEvent[]

  @@index([tournamentId, status])
  @@index([stageId, groupId])
}

enum MatchStatus {
  PENDING
  QUEUED
  PLAYING
  FINISHED
  CANCELLED
}

enum ResultType {
  NORMAL
  WALKOVER
  RETIRED
}

// ============ Рейтинг ============

// Журнал рейтинговых событий — источник истины (ТС 1.4, бриф запрет №3).
// Player.rating это проекция, которую можно пересобрать отсюда целиком.
model RatingEvent {
  id           String  @id @default(uuid())
  playerId     String
  matchId      String?
  tournamentId String?

  type         RatingEventType
  ratingBefore Decimal         @db.Decimal(8, 2)
  delta        Decimal         @db.Decimal(8, 2)
  ratingAfter  Decimal         @db.Decimal(8, 2)

  // Параметры расчёта — для аудита и пересчёта.
  opponentRating Decimal? @db.Decimal(8, 2)
  kFactor        Decimal? @db.Decimal(5, 2)
  tFactor        Decimal? @db.Decimal(5, 2)
  mFactor        Decimal? @db.Decimal(5, 2)
  expected       Decimal? @db.Decimal(6, 4)

  // ДОБАВЛЕНО сверх первой редакции ТС. Формула 2.0, ADR-003.
  //
  // gapMultiplier — множитель разрыва G: при превосходстве победителя
  // на 100 и более рейтинг не меняется ни у кого.
  //
  // imbalance — расхождение дельт. Ненулевое только когда победитель
  // провизорный. Это единственный канал, по которому рейтинг попадает
  // в систему извне, и он обязан быть измеримым (ТС 5.6).
  //
  // clamped — сработала отсечка по MIN_RATING, фактическая дельта
  // отличается от расчётной. Единственное место, где замкнутость
  // нарушается механически, поэтому фиксируется явно.
  gapMultiplier Decimal? @db.Decimal(5, 4)
  imbalance     Decimal? @db.Decimal(8, 2)
  clamped       Boolean  @default(false)

  reason    String? // для ручных корректировок
  createdBy String?
  createdAt DateTime @default(now())

  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match      Match?      @relation(fields: [matchId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([playerId, createdAt(sort: Desc)])
  @@index([tournamentId])
  @@index([matchId])
}

enum RatingEventType {
  MATCH
  INITIAL
  MANUAL_ADJUST
  RECALC
}

// ============ Финансы ============

model Transaction {
  id           String          @id @default(uuid())
  clubId       String
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  tournamentId String?
  description  String
  createdAt    DateTime        @default(now())

  club       Club        @relation(fields: [clubId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([clubId, createdAt(sort: Desc)])
}

enum TransactionType {
  TOPUP
  TOURNAMENT_FEE
  REFUND
  ADJUSTMENT
  PAYOUT
}

model Tariff {
  id               String  @id @default(uuid())
  name             String
  perParticipant   Int // тенге за участника
  perTournamentCap Int? // потолок за турнир
  monthlyFee       Int? // подписка
  isDefault        Boolean @default(false)

  clubs Club[]
}

// ============ Аномалии рейтинга ============

model RatingAnomaly {
  id         String        @id @default(uuid())
  playerId   String
  matchId    String?
  type       AnomalyType
  severity   Int // 1-10
  details    Json
  status     AnomalyStatus @default(OPEN)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime      @default(now())

  @@index([status, severity(sort: Desc)])
  @@index([playerId])
}

enum AnomalyType {
  LOSS_STREAK_BEFORE_CAPPED
  UPSET_LOSS
  PATTERN_DROP_WIN_RETURN
  UNUSUAL_SCORE
}

enum AnomalyStatus {
  OPEN
  REVIEWING
  CONFIRMED
  DISMISSED
}

// ============ Синхронизация офлайн-консоли ============

// ТС 6.3 и ADR-026. Журнал операций, пришедших из очереди консоли.
//
// Запись появляется ДО применения операции: обрыв между применением
// и отметкой оставил бы её неотмеченной, и повторная отправка применила бы
// счёт дважды. Уникальный (tournamentId, clientOpId) — это и есть
// идемпотентность синхронизации.
model SyncOperation {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  clientOpId String // UUID, выданный клиентом
  seq        Int // порядок в очереди клиента
  type       String // тип операции, ТС 6.2
  payload    Json?

  // Версия снимка, против которого судья вводил операцию. Ничего не
  // блокирует: конфликт решает порядок (ADR-026). Нужна для разбора спора.
  basedOnVersion Int

  actorId        String
  receivedAt     DateTime  @default(now())
  appliedAt      DateTime?
  // Код отказа из общего перечня. Заполнен — операция отклонена.
  rejectedReason String?

  @@unique([tournamentId, clientOpId])
  @@index([tournamentId, seq])
}

// ============ Журнал действий ============

// ТЗ 12 и ТС 8.3: все изменения рейтинга, финансовые операции
// и изменения результатов протоколируются.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}
