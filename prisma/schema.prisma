// Схема данных KTTF.
//
// Источник истины по модели — kttf-shared/docs/03-tech-spec.md, раздел 4.
// Изменения, накопленные по ходу разработки, перечислены там же в 05-state.md,
// раздел 6, и здесь помечены комментариями с указанием причины.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Строка подключения живёт в prisma.config.ts: начиная с Prisma 7
// свойство url в схеме не поддерживается. Клиент подключается через
// адаптер драйвера, а не через строку из схемы.
datasource db {
  provider = "postgresql"
}

// ============ Пользователи ============

model User {
  id            String    @id @default(uuid())
  phone         String    @unique // E.164, +7XXXXXXXXXX
  // Логин — второй способ войти (ADR-034). Необязателен: аккаунты, заведённые
  // до перехода на пароль, живут без него.
  login         String?   @unique
  // scrypt с солью на пользователя, средствами node:crypto. Пустой означает,
  // что войти этим аккаунтом пока нельзя.
  passwordHash  String?
  phoneVerified Boolean   @default(false)
  email         String?   @unique
  locale        Locale    @default(RU)
  // Числовой chat_id Telegram. Уведомления — V2 (ТЗ 10), но собирается такое
  // годами, а понадобится сразу, поэтому поле заводится заранее. По @имени
  // бот писать не может, отсюда число, а не ник.
  telegramId    String?
  // Администратор платформы — ТЗ 1, ADR-046. Ведёт справочники. Выдаётся
  // скриптом scripts/set-admin.mjs: маршрута, который делает человека
  // администратором, наружу нет.
  isAdmin       Boolean   @default(false)
  // Последнее посещение — ADR-050. Пишется на запросах с токеном не чаще
  // раза в пять минут: точнее «в сети» не нужно, а запись на каждый запрос
  // превратила бы чтение сайта в поток UPDATE.
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())

  player           Player?
  clubRoles        ClubMember[]
  clubPosts        ClubPost[]
  clubMedia        ClubMedia[]
  sessions         Session[]
  clubApplications ClubApplication[]
  products         Product[]
}

enum Locale {
  KK
  RU
  EN
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  createdAt    DateTime @default(now())
  // ТЗ 2.1: сессия живёт 90 дней и продлевается при активности
  expiresAt    DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ============ Игроки ============

model Player {
  id     String  @id @default(uuid())
  userId String? @unique // null = заведён организатором, аккаунта нет
  user   User?   @relation(fields: [userId], references: [id])

  lastName      String
  firstName     String
  middleName    String? // необязательно — бриф, запрет №6
  birthYear     Int
  // Полная дата рождения — необязательна (ADR-035). Источник истины для
  // допуска остаётся birthYear: возрастные категории считаются по году,
  // и сравнение с birthYearFrom/birthYearTo идёт с ним. Год и дата обязаны
  // говорить одно и то же — правило в общем коде, createPlayerSchema.
  birthDate     DateTime? @db.Date
  // Показывать посторонним только год — ADR-037. Хранится ровно так, как
  // звучит галочка в форме: поле с отрицанием рано или поздно прочитают
  // наоборот, и дата уедет наружу у того, кто её прятал. Умолчание true:
  // до появления даты профиль показывал только год, и включённая галочка
  // ничего не меняет в том, что о человеке видно.
  birthYearOnly Boolean   @default(true)
  gender        Gender
  // Город из справочника — ADR-046. Была свободная строка, и «Алматы»
  // с «алматы » расходились по фильтрам как два разных города.
  cityId        String
  city          City      @relation(fields: [cityId], references: [id])
  photoUrl      String?
  clubId        String?
  club          Club?     @relation(fields: [clubId], references: [id])

  // Анкета ТЗ 2.2. Инвентарь строкой, а не справочником: свой справочник
  // моделей нужно наполнять и чистить, это отдельный продукт (ADR-035).
  playingHand    PlayingHand?
  grip           Grip?
  blade          String?
  rubberForehand String?
  rubberBackhand String?
  bio            String?

  // Тренер задаётся либо выбором из уже заведённых игроков, либо строкой,
  // но не обоими сразу. Роли тренера в продукте ещё нет: «тренер» — это тот,
  // на кого сослались, и список берётся из самих данных.
  coachPlayerId String?
  coach         Player?  @relation("PlayerCoach", fields: [coachPlayerId], references: [id])
  students      Player[] @relation("PlayerCoach")
  coachName     String?

  // Проекция рейтинга. Источник истины — RatingEvent, это материализованное
  // представление для быстрых выборок (ТС 1.4).
  rating        Decimal @default(250) @db.Decimal(8, 2)
  ratedMatches  Int     @default(0)
  isProvisional Boolean @default(true)
  trustScore    Decimal @default(100) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  registrations Registration[]
  ratingEvents  RatingEvent[]

  @@index([rating(sort: Desc)])
  @@index([cityId, rating(sort: Desc)])
  @@index([lastName, firstName])
  // Список тренеров — это выборка distinct по ссылке. Без индекса она
  // прочитала бы всю таблицу игроков ради выпадающего списка в форме.
  @@index([coachPlayerId])
}

enum Gender {
  MALE
  FEMALE
}

/// Игровая рука — ТЗ 2.2.
enum PlayingHand {
  RIGHT
  LEFT
}

/// Хват — ТЗ 2.2. Третьего в настольном теннисе нет: европейский
/// (горизонтальный) и азиатский, он же «перо».
enum Grip {
  SHAKEHAND
  PENHOLD
}

// ============ Справочник стран и городов ============

// ADR-046. Ведёт администратор платформы. Записи не удаляются, а скрываются:
// на город ссылаются клубы и игроки, и удаление оставило бы их без города.
// Скрытый город не предлагается в формах, но остаётся у тех, у кого указан.
//
// Название по-русски обязательно, по-казахски — по желанию: казахский
// интерфейс без него показывает русское.

model Country {
  id        String  @id @default(uuid())
  code      String  @unique // ISO 3166-1 alpha-2
  name      String
  nameKk    String?
  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  cities City[]
}

model City {
  id        String  @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  name      String
  nameKk    String?
  // Столицы впереди, остальное по алфавиту: порядок задаёт администратор.
  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  clubs   Club[]
  players Player[]

  @@unique([countryId, name])
}

// ============ Клубы ============

model Club {
  id          String  @id @default(uuid())
  name        String
  shortName   String?
  cityId      String // справочник, ADR-046
  city        City    @relation(fields: [cityId], references: [id])
  address     String?
  lat         Float?
  lng         Float?
  tableCount  Int     @default(1)
  phone       String?
  whatsapp    String?
  instagram   String?
  logoUrl     String?
  description String?

  // Страница клуба — ADR-055, docs/09
  coverUrl          String?
  website           String?
  telegram          String?
  twoGisUrl         String?
  amenities         ClubAmenity[] @default([])
  tableBrand        String?
  floorType         FloorType?
  ceilingHeightCm   Int?
  hoursNote         String?
  primaryContact    ContactKind?
  profileReviewedAt DateTime?
  // Тариф страницы заложен и выключен (ADR-055); это не Tariff — плата за турниры
  plan              ClubPlan      @default(FREE)
  planUntil         DateTime?
  // Скрыт из каталога администратором
  hiddenAt          DateTime?

  balance  Decimal @default(0) @db.Decimal(12, 2)
  tariffId String?
  tariff   Tariff? @relation(fields: [tariffId], references: [id])

  createdAt DateTime @default(now())

  members      ClubMember[]
  tournaments  Tournament[]
  players      Player[]
  transactions Transaction[]
  hours        ClubHours[]
  prices       ClubPrice[]
  stats        ClubStatDaily[]
  posts        ClubPost[]
  media        ClubMedia[]

  @@index([cityId])
}

enum ClubAmenity {
  AIR_CONDITIONING
  SHOWER
  PARKING
  LOCKER_ROOM
  WIFI
  CAFE
  SHOP
  KIDS
}

enum FloorType {
  SPORT_COVER
  LINOLEUM
  WOOD
  OTHER
}

enum ContactKind {
  PHONE
  WHATSAPP
  TELEGRAM
}

enum ClubPlan {
  FREE
  PRO
}

// Часы работы: минуты от полуночи по UTC+5; closesMin > 1440 — после полуночи
model ClubHours {
  clubId    String
  weekday   Int // 1 — понедельник … 7 — воскресенье
  opensMin  Int
  closesMin Int
  club      Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, weekday, opensMin])
}

model ClubPrice {
  id        String    @id @default(uuid())
  clubId    String
  kind      PriceKind
  title     String
  priceKzt  Int
  unit      PriceUnit
  note      String?
  sortOrder Int
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, sortOrder])
}

enum PriceKind {
  TABLE_RENT
  MEMBERSHIP
  TRAINING
  KIDS
  OTHER
}

enum PriceUnit {
  HOUR
  VISIT
  MONTH
  COURSE
  NONE
}

// Дневные счётчики страницы клуба — без IP и cookie (ADR-055)
model ClubStatDaily {
  clubId          String
  date            DateTime      @db.Date // день по UTC+5
  source          TrafficSource
  views           Int           @default(0)
  phoneClicks     Int           @default(0)
  whatsappClicks  Int           @default(0)
  telegramClicks  Int           @default(0)
  instagramClicks Int           @default(0)
  websiteClicks   Int           @default(0)
  routeClicks     Int           @default(0)
  club            Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, date, source])
}

enum TrafficSource {
  ORGANIC
  CAMPAIGN
}

// Новости и акции клуба — ADR-055, docs/09 3.2. Публикуются сразу, администратор скрывает
model ClubPost {
  id           String    @id @default(uuid())
  clubId       String
  kind         PostKind
  title        String
  body         String // простой текст, без HTML
  imageUrl     String?
  validUntil   DateTime? @db.Date // последний день акции
  pinnedAt     DateTime?
  publishedAt  DateTime  @default(now())
  editedAt     DateTime?
  authorId     String?
  hiddenAt     DateTime?
  hiddenReason String?
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clubId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
}

enum PostKind {
  NEWS
  PROMO
}

// Фото и видео клуба. У видео imageUrl — его обложка, скачанная к нам
model ClubMedia {
  id           String    @id @default(uuid())
  clubId       String
  kind         MediaKind
  imageUrl     String
  youtubeId    String?
  width        Int
  height       Int
  caption      String?
  sortOrder    Int
  createdById  String?
  createdAt    DateTime  @default(now())
  hiddenAt     DateTime?
  hiddenReason String?
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clubId, sortOrder])
  @@index([createdAt(sort: Desc)])
}

enum MediaKind {
  PHOTO
  VIDEO
}

model ClubMember {
  id     String   @id @default(uuid())
  clubId String
  userId String
  role   ClubRole
  club   Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

enum ClubRole {
  OWNER
  ORGANIZER
  REFEREE
}

// ============ Заявки клубов ============

// ADR-047. Зал, который хочет проводить турниры в KTTF, оставляет заявку на
// сайте; администратор платформы видит её в кабинете и связывается сам.
// Отправить может и аноним: представитель зала ещё не пользователь.
model ClubApplication {
  id          String                @id @default(uuid())
  name        String
  // Телефон или email как написал человек: формат не навязывается.
  contact     String
  clubName    String
  // Строкой, не ссылкой на справочник: заявки приходят и из городов,
  // которых в справочнике ещё нет.
  city        String
  address     String?
  tableCount  Int?
  tournaments String?
  message     String?
  status      ClubApplicationStatus @default(NEW)
  // Заявку оставил вошедший пользователь. Удалён аккаунт — заявка остаётся.
  userId      String?
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  // HMAC адреса отправителя — для лимита заявок с одного адреса. Сам адрес
  // не хранится: для лимита достаточно сравнить, а адрес — персональные данные.
  ipHash      String
  createdAt   DateTime              @default(now())
  handledAt   DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
}

enum ClubApplicationStatus {
  NEW
  DONE
}

// ============ Каталог маркета ============

// ADR-058, docs/10 4.1. Общий справочник инвентаря: товары и производители.
// Ведёт администратор платформы, наполняется импортом выгрузки RTTF.
// Поиск — pg_trgm: индексы по lower(name) заведены в миграции SQL, схема
// Prisma выражений в индексах не описывает.
model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  country   String?
  website   String?
  logoUrl   String?
  // Производитель RTTF — ключ повторного импорта
  rttfId    Int?      @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String          @id @default(uuid())
  category    ProductCategory
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id])
  // «E. Lebesson» — без слова категории и производителя
  name        String
  slug        String          @unique
  // Русские написания для поиска: «Лебессон»
  aliases     String[]        @default([])
  description String? // простой текст
  // Характеристики и оси вариантов. Схема — по категории, PRODUCT_ATTRIBUTES
  // в kttf-shared: база её не знает, проверяет сервер
  attrs       Json            @default("{}")
  options     Json            @default("{}")
  status      ProductStatus   @default(PUBLISHED)
  // Порядок «популярные»: просмотры, при импорте — начальное значение RTTF
  popularity  Int             @default(0)
  // Товар RTTF — ключ повторного импорта
  rttfId      Int?            @unique
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  hiddenAt    DateTime?
  images      ProductImage[]

  @@index([category, status, hiddenAt])
  @@index([brandId])
  @@index([attrs], type: Gin)
  @@index([options], type: Gin)
}

enum ProductCategory {
  BLADE
  RUBBER
  RACKET
  BALL
  CASE
  BAG
  TOP
  BOTTOM
  SOCKS
  SHOES
  TABLE
  OTHER
}

// PENDING — карточку предложил магазин (M1.3), в общем каталоге её нет
enum ProductStatus {
  PENDING
  PUBLISHED
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  width     Int
  height    Int
  sortOrder Int
  // Откуда фото: rttf.ru, магазин, производитель — чтобы найти и заменить чужое
  credit    String?
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// ============ Турниры ============

model Tournament {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  name               String
  startsAt           DateTime
  registrationEndsAt DateTime?
  status             TournamentStatus @default(DRAFT)

  entryFee          Int      @default(0) // тенге
  maxParticipants   Int?
  ratingCapMax      Decimal? @db.Decimal(8, 2)
  ratingCapMin      Decimal? @db.Decimal(8, 2)
  // Заявки вне рейтинговой планки — на рассмотрение организатора, а не
  // отказ (ADR-044). Возраст и пол остаются жёсткими условиями.
  reviewOutOfRating Boolean  @default(false)
  birthYearFrom     Int?
  birthYearTo       Int?
  genderLimit       Gender?

  level      TournamentLevel @default(CLUB) // коэффициент T в формуле рейтинга
  tableCount Int

  formatConfig  Json // конфигурация схемы, ТС 4.2
  seedingConfig Json? // посев и разведение по клубам, ТС 4.2 и ADR-011

  description String?
  prizeInfo   String?

  publicToken String @unique // второй экран, ТЗ 6.5

  // Офлайн-синхронизация, ТС 6.3: растёт на каждое изменение турнира.
  // Консоль присылает версию снимка, против которого работала.
  version Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  ratedAt    DateTime?
  // Места записаны в заявки (ADR-048). Пусто у завершённого турнира — он
  // завершён до ADR-048, места досчитываются при первом обращении.
  placesAt   DateTime?

  registrations  Registration[]
  stages         Stage[]
  matches        Match[]
  ratingEvents   RatingEvent[]
  transactions   Transaction[]
  syncOperations SyncOperation[]

  @@index([status, startsAt])
  @@index([clubId, startsAt(sort: Desc)])
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REG_OPEN
  REG_CLOSED
  RUNNING
  FINISHED
  RATED
  CANCELLED
}

enum TournamentLevel {
  CLUB
  REGIONAL
  NATIONAL
}

model Registration {
  id           String             @id @default(uuid())
  tournamentId String
  playerId     String
  status       RegistrationStatus @default(REGISTERED)
  seed         Int?
  isRated      Boolean            @default(true) // false = вне зачёта
  paidAt       DateTime?
  paymentId    String?

  // ДОБАВЛЕНО сверх первой редакции ТС. Причина — ТС 5.4: рейтинги
  // фиксируются на момент старта турнира. Без снимка расчёт зависит от
  // порядка обработки встреч, и локальный расчёт консоли расходится
  // с серверным. Заполняются при переходе турнира в RUNNING.
  ratingAtStart  Decimal? @db.Decimal(8, 2)
  matchesAtStart Int?

  // Итоговое место — ADR-048. Записывается при завершении турнира, чтобы
  // профиль игрока не пересчитывал весь турнир ради одного числа. Делённое
  // место — диапазоном place–placeTo («5–8»); точное — placeTo пуст.
  place   Int?
  placeTo Int?

  createdAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([tournamentId, status])
  @@index([playerId])
}

enum RegistrationStatus {
  REGISTERED
  // Заявка вне рейтинговой планки ждёт решения организатора, отказ по ней —
  // REJECTED (ADR-044). Ни та, ни другая места в турнире не занимает.
  PENDING
  WAITLIST
  CONFIRMED
  PLAYING
  WITHDRAWN
  NO_SHOW
  REJECTED
}

// ============ Этапы и встречи ============

model Stage {
  id           String    @id @default(uuid())
  tournamentId String
  order        Int
  type         StageType
  name         String
  config       Json

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups     Group[]
  matches    Match[]

  @@unique([tournamentId, order])
}

enum StageType {
  GROUPS
  KNOCKOUT
  ROUND_ROBIN
  CONSOLATION
}

model Group {
  id      String @id @default(uuid())
  stageId String
  label   String // «гр. 1»
  order   Int
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  matches      Match[]
  tieDecisions TieDecision[]

  @@unique([stageId, order])
}

// Решение судьи по равенству в таблице (ADR-008).
//
// Движок не бросает жребий: он возвращает предложенный порядок и признак,
// что равенство не разрешено. Решение судьи хранится здесь и приходит
// в расчёт параметром, поэтому функция остаётся чистой и детерминированной,
// а консоль в офлайне и сервер получают одинаковые места.
model TieDecision {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Участники в порядке, который выбрал судья: массив Player.id.
  //
  // Именно Player.id, а не Registration.id: встреча ссылается на игроков,
  // и таблица считается по тем же ключам. Два разных ключа для одного
  // участника разошлись бы при первом же сравнении.
  orderedIds Json

  decidedBy String
  decidedAt DateTime @default(now())
  note      String?

  @@index([groupId])
}

model Match {
  id           String  @id @default(uuid())
  tournamentId String
  stageId      String
  groupId      String?

  // Участник может быть ещё не определён: в олимпийской сетке полуфинал —
  // это «победитель такой-то встречи». Пока он не сыгран, игрока здесь нет,
  // а откуда он возьмётся, сказано в sourceA/sourceB. Без этого сетку нельзя
  // развернуть целиком при жеребьёвке, а ТЗ 9.4 требует показывать её
  // в результатах, и второй экран показывает её по ходу турнира. См. ADR-019.
  playerAId String?
  playerBId String?

  // { "kind": "WINNER" | "LOSER", "matchId": "<Match.id>" } либо null,
  // если участник известен сразу.
  sourceA Json?
  sourceB Json?

  status      MatchStatus @default(PENDING)
  tableNumber Int?

  setsA      Int?
  setsB      Int?
  setScores  Json? // [[11,9],[9,11],[11,7]]
  resultType ResultType?

  bracketRound Int?
  bracketSlot  Int?

  startedAt  DateTime?
  finishedAt DateTime?

  // Офлайн-синхронизация, ТС 6
  clientId      String? @unique // UUID, сгенерированный клиентом
  clientVersion Int     @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group      Group?     @relation(fields: [groupId], references: [id])

  ratingEvents RatingEvent[]

  @@index([tournamentId, status])
  @@index([stageId, groupId])
}

enum MatchStatus {
  PENDING
  QUEUED
  PLAYING
  FINISHED
  CANCELLED
}

enum ResultType {
  NORMAL
  WALKOVER
  RETIRED
}

// ============ Рейтинг ============

// Журнал рейтинговых событий — источник истины (ТС 1.4, бриф запрет №3).
// Player.rating это проекция, которую можно пересобрать отсюда целиком.
model RatingEvent {
  id           String  @id @default(uuid())
  playerId     String
  matchId      String?
  tournamentId String?

  type         RatingEventType
  ratingBefore Decimal         @db.Decimal(8, 2)
  delta        Decimal         @db.Decimal(8, 2)
  ratingAfter  Decimal         @db.Decimal(8, 2)

  // Параметры расчёта — для аудита и пересчёта.
  opponentRating Decimal? @db.Decimal(8, 2)
  kFactor        Decimal? @db.Decimal(5, 2)
  tFactor        Decimal? @db.Decimal(5, 2)
  mFactor        Decimal? @db.Decimal(5, 2)
  expected       Decimal? @db.Decimal(6, 4)

  // ДОБАВЛЕНО сверх первой редакции ТС. Формула 2.0, ADR-003.
  //
  // gapMultiplier — множитель разрыва G: при превосходстве победителя
  // на 100 и более рейтинг не меняется ни у кого.
  //
  // imbalance — расхождение дельт. Ненулевое только когда победитель
  // провизорный. Это единственный канал, по которому рейтинг попадает
  // в систему извне, и он обязан быть измеримым (ТС 5.6).
  //
  // clamped — сработала отсечка по MIN_RATING, фактическая дельта
  // отличается от расчётной. Единственное место, где замкнутость
  // нарушается механически, поэтому фиксируется явно.
  gapMultiplier Decimal? @db.Decimal(5, 4)
  imbalance     Decimal? @db.Decimal(8, 2)
  clamped       Boolean  @default(false)

  reason    String? // для ручных корректировок
  createdBy String?
  createdAt DateTime @default(now())

  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match      Match?      @relation(fields: [matchId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([playerId, createdAt(sort: Desc)])
  @@index([tournamentId])
  @@index([matchId])
}

enum RatingEventType {
  MATCH
  INITIAL
  MANUAL_ADJUST
  RECALC
}

// ============ Финансы ============

model Transaction {
  id           String          @id @default(uuid())
  clubId       String
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  tournamentId String?
  description  String
  createdAt    DateTime        @default(now())

  club       Club        @relation(fields: [clubId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([clubId, createdAt(sort: Desc)])
}

enum TransactionType {
  TOPUP
  TOURNAMENT_FEE
  REFUND
  ADJUSTMENT
  PAYOUT
}

model Tariff {
  id               String  @id @default(uuid())
  name             String
  perParticipant   Int // тенге за участника
  perTournamentCap Int? // потолок за турнир
  monthlyFee       Int? // подписка
  isDefault        Boolean @default(false)

  clubs Club[]
}

// ============ Аномалии рейтинга ============

model RatingAnomaly {
  id         String        @id @default(uuid())
  playerId   String
  matchId    String?
  type       AnomalyType
  severity   Int // 1-10
  details    Json
  status     AnomalyStatus @default(OPEN)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime      @default(now())

  @@index([status, severity(sort: Desc)])
  @@index([playerId])
}

enum AnomalyType {
  LOSS_STREAK_BEFORE_CAPPED
  UPSET_LOSS
  PATTERN_DROP_WIN_RETURN
  UNUSUAL_SCORE
}

enum AnomalyStatus {
  OPEN
  REVIEWING
  CONFIRMED
  DISMISSED
}

// ============ Синхронизация офлайн-консоли ============

// ТС 6.3 и ADR-026. Журнал операций, пришедших из очереди консоли.
//
// Запись появляется ДО применения операции: обрыв между применением
// и отметкой оставил бы её неотмеченной, и повторная отправка применила бы
// счёт дважды. Уникальный (tournamentId, clientOpId) — это и есть
// идемпотентность синхронизации.
model SyncOperation {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  clientOpId String // UUID, выданный клиентом
  seq        Int // порядок в очереди клиента
  type       String // тип операции, ТС 6.2
  payload    Json?

  // Версия снимка, против которого судья вводил операцию. Ничего не
  // блокирует: конфликт решает порядок (ADR-026). Нужна для разбора спора.
  basedOnVersion Int

  actorId        String
  receivedAt     DateTime  @default(now())
  appliedAt      DateTime?
  // Код отказа из общего перечня. Заполнен — операция отклонена.
  rejectedReason String?

  @@unique([tournamentId, clientOpId])
  @@index([tournamentId, seq])
}

// ============ Журнал действий ============

// ТЗ 12 и ТС 8.3: все изменения рейтинга, финансовые операции
// и изменения результатов протоколируются.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}
